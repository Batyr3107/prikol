# Production Environment Variables

# Application
NODE_ENV=production
PORT=3000
HOST=0.0.0.0

# PostgreSQL Database
POSTGRES_DB=prikol
POSTGRES_USER=prikol_user
POSTGRES_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD
DATABASE_URL="postgresql://prikol_user:CHANGE_ME_TO_STRONG_PASSWORD@postgres:5432/prikol?schema=public"

# Telegram Bot
TELEGRAM_BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrsTUVwxyz-CHANGE_ME

# Security (optional but recommended)
# Разделенные запятыми домены для CORS
CORS_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Logging
LOG_LEVEL=info

# Rate Limiting (optional custom values)
RATE_LIMIT_GENERAL=100
RATE_LIMIT_CREATE=10
RATE_LIMIT_VOTE=50
